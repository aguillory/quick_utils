// ==UserScript==
// @name         BidFTA Friend Highlighter
// @namespace    http://tampermonkey.net/
// @version      1.2
// @description  Highlight BidFTA items and bid history where friends are bidding.
// @author       You
// @match        *://*.bidfta.com/*
// @grant        none
// ==/UserScript==

(function() {
    'use strict';

    // List of friends' bidder number suffixes
    const friends = {
        "438216": "Susan",
        "429722": "Barbara",
        "416372": "Angie",
        "418004": "Vicky",
        "471458": "Carrina",
        "461608": "Marla",
        "483037": "Karen",
        "420743": "Alyssa"
    };

    // --- Main Page Card Highlighter ---
    function highlightFriends() {
        const nextDataScript = document.getElementById('__NEXT_DATA__');
        if (!nextDataScript) return;

        try {
            const data = JSON.parse(nextDataScript.textContent);
            let flaggedItems = [];

            // Helper function to recursively find items in the JSON data
            function findBidders(obj) {
                if (Array.isArray(obj)) {
                    obj.forEach(findBidders);
                } else if (typeof obj === 'object' && obj !== null) {
                    if (obj.id && obj.highBidder) {
                        const bidderStr = String(obj.highBidder);
                        const matchedSuffix = Object.keys(friends).find(suffix => bidderStr.endsWith(suffix));

                        if (matchedSuffix) {
                            flaggedItems.push({
                                id: obj.id,
                                friendName: friends[matchedSuffix]
                            });
                        }
                    }
                    for (let key in obj) {
                        findBidders(obj[key]);
                    }
                }
            }

            findBidders(data);

            // Highlight the items in the DOM
            flaggedItems.forEach(item => {
                const itemLinks = document.querySelectorAll(`a[href*="/item-detail/${item.id}"]`);
                itemLinks.forEach(link => {
                    const card = link.closest('.rounded-xl') || link.parentElement;
                    if (card) {
                        card.style.border = '4px solid #ff4444';
                        card.style.backgroundColor = '#ffe6e6';

                        if (!card.querySelector('.friend-label')) {
                            const label = document.createElement('div');
                            label.className = 'friend-label';
                            label.style.backgroundColor = '#ff4444';
                            label.style.color = 'white';
                            label.style.padding = '6px';
                            label.style.fontWeight = 'bold';
                            label.style.textAlign = 'center';
                            label.style.fontSize = '14px';
                            label.innerText = `🚨 Highest Bidder: ${item.friendName} 🚨`;
                            card.prepend(label);
                        }
                    }
                });
            });

        } catch (e) {
            console.error("Error parsing BidFTA data for Friend Highlighter:", e);
        }
    }

    // --- Bids Popup Table Highlighter ---
    function scanForBidTables() {
        // Find all tables currently in the DOM
        const tables = document.querySelectorAll('table');

        tables.forEach(table => {
            // Ensure this is actually the "Bids" history table and not the "Increments" table
            const firstHeader = table.querySelector('th');
            if (firstHeader && firstHeader.textContent.includes('Bidder ID')) {

                const rows = table.querySelectorAll('tr:not(.friend-processed)');
                rows.forEach(row => {
                    const bidderIdCell = row.querySelector('td:first-child');
                    if (bidderIdCell) {
                        const bidderIdStr = bidderIdCell.textContent.trim();
                        const matchedSuffix = Object.keys(friends).find(suffix => bidderIdStr.endsWith(suffix));

                        if (matchedSuffix) {
                            row.classList.add('friend-processed');
                            bidderIdCell.textContent = friends[matchedSuffix];
                            row.style.backgroundColor = '#ffe6e6';
                            row.style.color = '#ff4444';
                            row.style.fontWeight = 'bold';
                        }
                    }
                });
            }
        });
    }

    // Run the main script after a short delay
    setTimeout(highlightFriends, 1500);

    // --- Upgraded Observer ---
    let lastUrl = location.href;
    let debounceTimer = null;

    new MutationObserver(() => {
        // 1. SPA Routing Check
        const url = location.href;
        if (url !== lastUrl) {
            lastUrl = url;
            setTimeout(highlightFriends, 1500);
        }

        // 2. React DOM Insertion Check (Debounced)
        // Clears the timer if mutations are happening rapidly (like data fetching in progress)
        // and only fires the table scan once the DOM has been quiet for 150ms.
        if (debounceTimer) clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
            scanForBidTables();
        }, 150);

    }).observe(document.body, {subtree: true, childList: true});

})();
